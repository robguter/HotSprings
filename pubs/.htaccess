RewriteEngine On

RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(index|inicio)\.php[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(things-to-do-in-hot-springs|where-to-stay-in-hot-springs|hot-springs-2-day-itinerary|contacto|privacidad|terminos)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+es/(index|inicio)\.php[\s?] [NC]
RewriteRule ^ /es/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+es/(things-to-do-in-hot-springs|where-to-stay-in-hot-springs|hot-springs-2-day-itinerary)\.php[\s?] [NC]
RewriteRule ^ /es/%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l

RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

Options -Indexes