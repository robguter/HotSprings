RewriteEngine On

# 1. Si viene con www, quítalo y fuerza https (no aplica en localhost)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 2. Si viene sin www pero por http, fuerza https (no aplica en localhost)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 3. Redirección 301: fuerza la versión sin .php como canónica
RewriteCond %{THE_REQUEST} \s/+(index|belleza|hogar|vida|contacto|privacidad|terminos)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Si es un directorio, archivo o enlace válido, no lo redirijas
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l

# 5. Redirección al Front Control
RewriteRule ^(.+)$ index.php?url=$1 [QSA,L]

Options -Indexes